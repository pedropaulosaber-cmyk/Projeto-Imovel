# ============================================================================
# VÉRTICE — variáveis de ambiente
#
# Copie para `.env.local` e preencha. Nenhuma é obrigatória para o site subir:
# sem CRM e sem Supabase o formulário continua respondendo ao visitante e o
# lead fica no log de auditoria. O que **não** pode é uma variável existir
# malformada — aí o parse em `src/config/env.ts` derruba no boot, e não no
# primeiro lead que chega do Meta Ads.
#
# Nunca versione o arquivo com valor real.
# ============================================================================

NODE_ENV=development

# --- URL pública -------------------------------------------------------------
# Base de metadata, sitemap, robots e Schema.org. Sem barra no fim.
NEXT_PUBLIC_APP_URL="http://localhost:3000"

# --- Método CRM (produto irmão) ---------------------------------------------
# Endpoint que recebe o lead e segredo do HMAC-SHA256 do corpo.
# O segredo é diferente por ambiente e rotacionável. Mínimo de 32 caracteres:
#   openssl rand -base64 48
CRM_WEBHOOK_URL=""
LEAD_WEBHOOK_SECRET=""

# --- Meta (Pixel + Conversions API) ------------------------------------------
# NEXT_PUBLIC_META_PIXEL_ID vai para o navegador — é público por natureza.
# META_CAPI_TOKEN nunca: é ele que autoriza escrever eventos no seu pixel.
NEXT_PUBLIC_META_PIXEL_ID=""
META_PIXEL_ID=""
META_CAPI_TOKEN=""
# Preencha só enquanto estiver validando no Gerenciador de Eventos.
META_TEST_EVENT_CODE=""

# --- Supabase (projeto próprio deste site, separado do Método CRM) -----------
# Aplique `supabase/migrations/0001_init.sql` antes de ligar.
# A service_role ignora RLS: ela só existe no servidor, nunca no client.
SUPABASE_URL=""
SUPABASE_SERVICE_ROLE_KEY=""

# --- Operação ----------------------------------------------------------------
# Teto de envios de lead por IP por minuto (Edge Middleware).
RATE_LIMIT_LEADS_POR_MINUTO=5

# Autoriza o cron de reenvio em /api/leads/retry. Sem ele o endpoint recusa tudo.
CRON_SECRET=""

# Hosts autorizados para <Image> remoto, separados por vírgula.
# Ex.: xxxx.supabase.co
NEXT_PUBLIC_IMAGE_HOSTS=""
