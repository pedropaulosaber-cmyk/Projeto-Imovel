# ============================================================================
# AUTOMATIZE — variáveis de ambiente
#
# Copie para `.env` e preencha. O processo **não sobe** com uma variável
# obrigatória ausente ou malformada (ver `src/config/env.ts`) — falhar no boot
# é mais barato que descobrir no checkout do primeiro cliente.
#
# Nunca versione o `.env` com valor real.
# ============================================================================

NODE_ENV=development

# --- Banco de dados (obrigatório) -------------------------------------------
# Postgres 14+. Em produção, use conexão com SSL e um pooler (PgBouncer,
# Neon, Supabase) — o limite de conexões por instância está em prisma.ts.
DATABASE_URL="postgresql://usuario:senha@localhost:5432/automatize?schema=public"

# --- Segredo da aplicação (obrigatório) -------------------------------------
# Mínimo de 32 caracteres. Gere com: openssl rand -base64 48
# Usado para derivar o hash dos tokens de sessão e pseudonimizar IPs.
# Trocar este valor invalida todas as sessões ativas.
AUTH_SECRET=""

# --- URLs (obrigatório) ------------------------------------------------------
APP_URL="http://localhost:3000"
NEXT_PUBLIC_APP_URL="http://localhost:3000"
NEXT_PUBLIC_APP_NAME="AUTOMATIZE"

# --- Pagamentos (opcional) ---------------------------------------------------
# Sem estas, a plataforma funciona inteira menos comprar: o checkout devolve
# um erro explícito em vez de simular uma compra que não aconteceu.
# O webhook secret vem de: stripe listen --forward-to localhost:3000/api/webhooks/stripe
STRIPE_SECRET_KEY=""
STRIPE_WEBHOOK_SECRET=""

# Comissão da plataforma em pontos-base. 1500 = 15%.
PLATFORM_FEE_BPS=1500

# --- Armazenamento de arquivos (opcional) -----------------------------------
# Bucket S3-compatível e **privado** (AWS S3, Cloudflare R2, MinIO, Spaces).
# Sem estas, o upload e o download de entregáveis ficam indisponíveis.
# O bucket NÃO pode ter leitura pública: a entrega usa URL assinada.
S3_ENDPOINT=""
S3_REGION="us-east-1"
S3_BUCKET=""
S3_ACCESS_KEY_ID=""
S3_SECRET_ACCESS_KEY=""
S3_SIGNED_URL_TTL=300

# --- Observabilidade ---------------------------------------------------------
LOG_LEVEL=info

# Hosts autorizados para <Image> remoto, separados por vírgula.
NEXT_PUBLIC_IMAGE_HOSTS=""
