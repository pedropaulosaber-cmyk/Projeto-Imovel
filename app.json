{
  "expo": {
    "name": "Lumo",
    "slug": "lumo",
    "version": "1.0.0",
    "orientation": "portrait",
    "scheme": "lumo",
    "userInterfaceStyle": "automatic",
    "newArchEnabled": true,
    "backgroundColor": "#FFFFFF",
    "primaryColor": "#4F46E5",
    "assetBundlePatterns": ["**/*"],
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "app.lumo.mobile",
      "infoPlist": {
        "NSMicrophoneUsageDescription": "O Lumo usa o microfone para avaliar sua pronúncia nos exercícios de fala.",
        "NSSpeechRecognitionUsageDescription": "O Lumo usa reconhecimento de fala para pontuar sua pronúncia.",
        "UIBackgroundModes": ["fetch", "processing"]
      }
    },
    "android": {
      "package": "app.lumo.mobile",
      "adaptiveIcon": {
        "backgroundColor": "#4F46E5"
      },
      "permissions": [
        "android.permission.RECORD_AUDIO",
        "android.permission.INTERNET",
        "android.permission.ACCESS_NETWORK_STATE",
        "android.permission.VIBRATE"
      ]
    },
    "web": {
      "bundler": "metro",
      "output": "single",
      "name": "Lumo — Fluência, um dia de cada vez",
      "themeColor": "#4F46E5",
      "backgroundColor": "#FFFFFF",
      "shortName": "Lumo",
      "display": "standalone",
      "lang": "pt-BR"
    },
    "plugins": [
      "expo-router",
      "expo-sqlite",
      [
        "expo-splash-screen",
        {
          "backgroundColor": "#FFFFFF",
          "dark": { "backgroundColor": "#0B0B12" },
          "resizeMode": "contain"
        }
      ]
    ],
    "experiments": {
      "typedRoutes": false
    }
  }
}
